{
  "name": "eslint-config-it4c",
  "version": "0.13.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT4Change/eslint-config-it4c.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "default": "./dist/prettier.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "default": "./dist/modules/*.js"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "inspect-rules": "tsx scripts/inspect-rules.ts",
    "inspect-rules:check": "tsx scripts/inspect-rules.ts | diff rules.json -",
    "generate-rules-md": "tsx scripts/generate-rules-md.ts",
    "update-rules": "tsx scripts/inspect-rules.ts > rules.json && npm run generate-rules-md",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2 kB"
    },
    {
      "path": "dist/prettier.js",
      "limit": "1 kB"
    },
    {
      "path": "dist/modules/*.js",
      "limit": "6 kB"
    }
  ],
  "peerDependencies": {
    "eslint": ">= 10"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsonc": "^3.4.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-yml": "^3.6.0",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.65.0"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.2",
    "@types/eslint-plugin-promise": "^7.3.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "eslint": "^10.8.0",
    "size-limit": "^13.0.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
